# =====================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# (Project requirement 10: no credentials in source code.)
# =====================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://aegis_user:CHANGE_ME@localhost:5432/aegis

# Maximum pooled connections
PGPOOL_MAX=10

# Secret used to sign session cookies.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_long_random_string_at_least_32_chars
