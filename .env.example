# =====================================================================
# Docker Compose configuration.
#
# Copy this file to .env (same directory as docker-compose.yml) and
# change the values. Compose reads .env automatically.
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# =====================================================================

# --- database ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_to_something_random
POSTGRES_DB=aegis

# --- host ports (change if these are already in use) ---
DB_PORT=5432
APP_PORT=3000

# --- application ---
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_generate_a_long_random_string_at_least_32_chars
PGPOOL_MAX=10
